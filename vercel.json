{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/public/(.*)", "dest": "/public/$1" },
    { "src": "/sorting", "dest": "/server.js" },
    { "src": "/nqueens", "dest": "/server.js" },
    { "src": "/(.*)", "dest": "/server.js" }
  ]
}
